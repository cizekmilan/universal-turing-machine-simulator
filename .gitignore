## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user

# User-specific files generated by Visual Studio
.vs/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Rider / JetBrains
.idea/
*.sln.iml
*.csproj.DotSettings

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# TeamCity
_TeamCity*

# MSTest and VSTest
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
*.vsp
*.vspx
*.sap

# xUnit / coverlet / reports
coverage/
coverage.*/
TestResults/
*.cobertura.xml
*.opencover.xml
*.lcov
lcov.info

# BenchmarkDotNet
BenchmarkDotNet.Artifacts/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.assets.json
project.nuget.cache
*.nuget.dgspec.json

# NuGet package restore directory
packages/

# Microsoft Azure Build Output
csx/
*.build.csdef

# SQL Server files
*.mdf
*.ldf
*.ndf

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# Logs and local diagnostics
*.log
*.tlog
*.tmp
*.temp
*.pid
*.seed
*.pid.lock

# Environment files
.env
.env.*
!.env.example

# Publish output
publish/
app.publish/
*.Publish.xml
*.pubxml.user

# ClickOnce
*.application
*.manifest
*.deploy
*.deploymanifest

